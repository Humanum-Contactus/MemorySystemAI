# Exemple de configuration du nœud memory-node — AUCUN secret ici.
# Copier vers /etc/memory-node/memory-node.env (mode 600) et adapter.
# Les jetons d'API ne se mettent PAS dans ce fichier versionné :
#   /opt/memorysystemai/state/nvidia_token.txt   (mode 600)
#   /opt/memorysystemai/state/puter_token.txt    (mode 600)
# ou via NVIDIA_API_KEY / PUTER_AUTH_TOKEN dans le fichier d'environnement local (jamais commité).

# --- Serveur ---
AGENT_PORT=8765
PYTHONPATH=/opt/memorysystemai

# --- LLM (outil de consultation, pas l'identité) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct
# Second serveur Ollama du réseau local (optionnel) — À DÉFINIR,
# sinon la valeur par défaut codée dans organism.py s'applique :
OLLAMA_FALLBACK=http://<IP_SERVEUR_OLLAMA>:11434
NVIDIA_TEXT_MODEL=deepseek-ai/deepseek-v4-flash
PUTER_MODEL=moonshotai/kimi-k2
PUTER_VISION_MODEL=moonshotai/kimi-k3

# --- Vision ---
VISION_PROVIDER=nvidia
VISION_FALLBACK_PUTER=0

# --- Audio ---
WHISPER_MODEL=base
# VOICE_LOOP=1

# --- Autonomie (boucle de fond) ---
AUTONOMY_LOOP=1
AUTONOMY_INTERVAL=300

# --- Pont OpenClaw / Telegram (openclaw-skill/, optionnel) ---
MEMORY_NODE_URL=http://127.0.0.1:8765
ASK_POLLER_INTERVAL=20
# TELEGRAM_BOT_TOKEN=<À_DÉFINIR_HORS_GIT>
# TELEGRAM_CHAT_ID=<À_DÉFINIR_HORS_GIT>
# OPENCLAW_CONFIG=<CHEMIN_CONFIG_OPENCLAW>
